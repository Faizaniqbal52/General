{
  "name": "delivery-management-system",
  "version": "1.0.0",
  "description": "Delivery Management System — full CRUD platform with JWT authentication, role-based access control, and real-time delivery tracking via Socket.IO",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-force-exit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "delivery",
    "logistics",
    "jwt",
    "rbac",
    "socket.io",
    "express",
    "crud"
  ],
  "author": "Faizan Iqbal",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
